<?xml version="1.0" encoding="utf-8"?>
<resources>
    

    <style name="NcRoot">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">#F9F9FF</item>
    </style>
    

    <style name="NcContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
    </style>
    

    <style name="NcBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/plus_jakarta</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#111C2D</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>
    

    <style name="NcMuted" parent="NcBody">
        <item name="android:textColor">#53645B</item>
        <item name="android:textSize">12sp</item>
    </style>
    

    <style name="NcLabel" parent="NcBody">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    

    <style name="NcTitle" parent="NcBody">
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    

    <style name="NcSubtitle" parent="NcBody">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    

    <style name="NcBrand" parent="NcTitle">
        <item name="android:textSize">36sp</item>
        <item name="android:textColor">#006C49</item>
        <item name="android:gravity">center</item>
    </style>
    

    <style name="NcCenter" parent="NcMuted">
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
    </style>
    

    <style name="NcHeader" parent="NcSubtitle">
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:textColor">#006C49</item>
    </style>
    

    <style name="NcEyebrow" parent="NcBody">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#006C49</item>
        <item name="android:textStyle">bold</item>
    </style>
    

    <style name="NcSummary" parent="NcBody">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#006C49</item>
    </style>
    

    <style name="NcError" parent="NcBody">
        <item name="android:textColor">#B32635</item>
    </style>
    

    <style name="NcCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:background">@drawable/nc_card</item>
    </style>
    

    <style name="NcInput" parent="NcBody">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/nc_input</item>
        <item name="android:textColorHint">#69776F</item>
        <item name="android:saveEnabled">true</item>
    </style>
    

    <style name="NcButton" parent="NcBody">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/nc_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
    

    <style name="NcCoralButton" parent="NcButton">
        <item name="android:background">@drawable/nc_coral_button</item>
    </style>
    

    <style name="NcSecondaryButton" parent="NcButton">
        <item name="android:background">@drawable/nc_input</item>
        <item name="android:textColor">#006C49</item>
    </style>
    

    <style name="NcDangerButton" parent="NcButton">
        <item name="android:background">@drawable/nc_danger</item>
        <item name="android:textColor">#B32635</item>
    </style>
    

    <style name="NcBack" parent="NcSecondaryButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">32sp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:layout_marginBottom">0dp</item>
    </style>
    

    <style name="NcNav" parent="NcSecondaryButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:padding">4dp</item>
    </style>
    

</resources>
