<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/r_page">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:background="#FFFFFF">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/nutricare_logo" android:contentDescription="Logo NutriCare" android:scaleType="fitCenter" android:background="@drawable/r_circle" android:clipToOutline="true" android:layout_marginEnd="8dp"/>
        <TextView android:layout_width="44dp" android:layout_height="wrap_content" android:text="‹" android:textSize="30sp" android:fontFamily="@font/plus_jakarta" android:textColor="#006C49" android:id="@+id/btnBack" android:gravity="center" android:clickable="true" android:focusable="true"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Asisten NutriCare" android:textSize="20sp" android:fontFamily="@font/plus_jakarta" android:textColor="#006C49" android:layout_weight="1" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pengaturan" android:textSize="14sp" android:fontFamily="@font/plus_jakarta" android:textColor="#FFFFFF" android:id="@+id/btnAiSettings" android:gravity="center" android:padding="12dp" android:minHeight="48dp" android:background="@drawable/r_dark" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Asisten katalog offline" android:textSize="12sp" android:fontFamily="@font/plus_jakarta" android:textColor="#006C49" android:id="@+id/tvAiMode" android:padding="12dp" android:background="@drawable/r_mint"/>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cari jajanan" android:textSize="11sp" android:fontFamily="@font/plus_jakarta" android:textColor="#006C49" android:id="@+id/promptSnack" android:padding="10dp" android:background="@drawable/r_lavender" android:layout_margin="4dp" android:clickable="true" android:focusable="true"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kalori nasi putih" android:textSize="11sp" android:fontFamily="@font/plus_jakarta" android:textColor="#006C49" android:id="@+id/promptCalories" android:padding="10dp" android:background="@drawable/r_lavender" android:layout_margin="4dp" android:clickable="true" android:focusable="true"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bandingkan makanan" android:textSize="11sp" android:fontFamily="@font/plus_jakarta" android:textColor="#006C49" android:id="@+id/promptCompare" android:padding="10dp" android:background="@drawable/r_lavender" android:layout_margin="4dp" android:clickable="true" android:focusable="true"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hapus chat" android:textSize="11sp" android:fontFamily="@font/plus_jakarta" android:textColor="#006C49" android:id="@+id/btnClearChat" android:padding="10dp" android:background="@drawable/r_lavender" android:layout_margin="4dp" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </HorizontalScrollView>
    <androidx.recyclerview.widget.RecyclerView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:id="@+id/rvChat" android:padding="12dp" android:clipToPadding="false"/>
    <CheckBox android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/cbShareJournal" android:text="Sertakan profil &amp; ringkasan jurnal ke Gemini" android:fontFamily="@font/plus_jakarta" android:textSize="11sp" android:textColor="#53645B" android:buttonTint="#10B981" android:paddingHorizontal="12dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pesan dikirim ke Google hanya saat Gemini online aktif." android:textSize="10sp" android:fontFamily="@font/plus_jakarta" android:textColor="#53645B" android:paddingHorizontal="16dp" android:paddingBottom="6dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="#FFFFFF">
        <EditText android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:id="@+id/etMessage" android:hint="Tanya makanan Indonesia…" android:inputType="textCapSentences|textMultiLine" android:minLines="1" android:maxLines="5" android:maxLength="4000" android:fontFamily="@font/plus_jakarta" android:textSize="14sp" android:padding="12dp" android:background="@drawable/r_lavender"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kirim" android:textSize="14sp" android:fontFamily="@font/plus_jakarta" android:textColor="#FFFFFF" android:id="@+id/btnSend" android:gravity="center" android:padding="12dp" android:minHeight="48dp" android:background="@drawable/r_dark" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</LinearLayout>

