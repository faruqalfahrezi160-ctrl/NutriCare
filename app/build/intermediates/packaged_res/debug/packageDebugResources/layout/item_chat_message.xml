        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pesan" android:textSize="14sp" android:fontFamily="@font/plus_jakarta" android:textColor="#111C2D" android:id="@+id/tvChatBody" android:layout_marginTop="6dp" android:textIsSelectable="true"/>
    </LinearLayout>
